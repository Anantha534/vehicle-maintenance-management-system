# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is already in .gitignore.

# Database Connection (Prisma Postgres / Vercel Postgres)
# In Vercel, this is automatically configured or found in:
# Vercel Dashboard → Storage → Your Postgres DB → Settings / .env.local tab
# Used for runtime application queries.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Direct Database Connection (Optional - only required if using a PgBouncer pooler)
# If using a pooled database (e.g., Neon/PgBouncer with POSTGRES_PRISMA_URL),
# configure DIRECT_URL with the unpooled connection string (POSTGRES_URL_NON_POOLING)
# and add `directUrl = env("DIRECT_URL")` to server/prisma/schema.prisma.
# DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Local dev only — port for the Express server
PORT=5000
